# macOS
.DS_Store
**/.DS_Store

# Brainstorming / superpowers session files
.superpowers/

# Claude Code local config — settings are user-specific, skills are tracked
.claude/settings.json

# Secrets & config
.env
config/api_keys.json

# Python cache
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Virtual environments
venv/
.venv/

# Build artifacts
dist/
build/

# Memory & database (user data, not for repo)
memory/*.db
memory/*.sqlite3
memory/long_term.json
memory/voice_profile.npy
memory/*/

# Workspace files (user-generated content)
workspace/**
!workspace/**/.gitkeep

# Social media content (private drafts)
social-media/

# Logs
*.log
/tmp/viko*.log
viko/logs/

# SelfEngineer backups
viko/self_engineer/backups/

# Whisper model cache (auto-downloaded on first offline STT use, ~500 MB)
models/
